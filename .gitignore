# Dependencies
node_modules/

# Build output
dist/

# Environment & config
.env
.env.local
.abap.json

# Local ATC worklist output (check --atc --out)
.abap/

# Source maps
*.js.map

# Coverage
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Temp
*.tmp
*.log
tmp/

# abap pull output: flat abap-file-format artifacts directly under src/
# (transient, regenerated by `abap pull`; tracked CLI source lives in src/abap_cli/).
src/*.abap
src/*.json
src/*.ddic
src/*.acds
src/*.abdl
src/*.properties
# Wiki knowledge base: tracked by default. Only local drafts/scratch live here.
wiki/_local/

# Local real-SAP evidence and scratch bundles (never committed)
tests/
*.bundle

# Local agent context (repo-specific skills; not published)
.agents/

# validate:aff negative scratch fixtures (created on demand by tests; must not be scanned)
test/fixtures/_negative/
