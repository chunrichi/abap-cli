    field_name TYPE string,
    rollname   TYPE string,
    data_type  TYPE string,
    length     TYPE i,
    decimals   TYPE i,
    key_flag   TYPE abap_bool,
  END OF ty_ddic_field_out_stru,
  tt_ddic_field_out_stru TYPE STANDARD TABLE OF ty_ddic_field_out_stru WITH EMPTY KEY,
  " read-side payloads mirror AFF nested wire so the ICF client
  " can consume `format.*` / `dataTypeInformation.*` without remapping.
  BEGIN OF ty_ddic_get_doma_data,
    name        TYPE string,
    type        TYPE string,
    description TYPE string,
    format      TYPE ty_doma_format,
  END OF ty_ddic_get_doma_data,
  BEGIN OF ty_ddic_get_dtel_data,
    name                  TYPE string,
    type                  TYPE string,
    description           TYPE string,
    data_type_information TYPE ty_dtel_data_type_info,
    short_text            TYPE string,
    medium_text           TYPE string,
    long_text             TYPE string,
    header_text           TYPE string,
  END OF ty_ddic_get_dtel_data,
  BEGIN OF ty_ddic_get_tabl_data,
    name             TYPE string,
    type             TYPE string,
    description      TYPE string,
    delivery_class   TYPE string,
    data_class       TYPE string,
    size_category    TYPE string,
    client_dependent TYPE abap_bool,
    fields           TYPE tt_ddic_field_out,
  END OF ty_ddic_get_tabl_data,
  BEGIN OF ty_ddic_get_stru_data,
    name        TYPE string,
    type        TYPE string,
    description TYPE string,
    fields      TYPE tt_ddic_field_out_stru,
  END OF ty_ddic_get_stru_data.

" ----- VIEW (database view) CRUD over the local view-v1 document -----
" Wire is camelCase (pretty_mode-camel_case); component names are the AFF
" local field names in snake_case. Tables / fields / join conditions map 1:1
" onto DD26V / DD27P / DD28J; selection conditions map onto DD28V.
TYPES:
  BEGIN OF ty_view_table,
    table_name         TYPE string,
    table_position     TYPE i,
    foreign_table_name TYPE string,
    for_field          TYPE string,
    for_direction      TYPE string,
  END OF ty_view_table,
  tt_view_table TYPE STANDARD TABLE OF ty_view_table WITH EMPTY KEY,
  BEGIN OF ty_view_field,
    view_field_name      TYPE string,
    table_name           TYPE string,
    field_name           TYPE string,
    key_flag             TYPE abap_bool,
    roll_name            TYPE string,
    view_field_roll_name TYPE string,
  END OF ty_view_field,
  tt_view_field TYPE STANDARD TABLE OF ty_view_field WITH EMPTY KEY,
  BEGIN OF ty_view_join,
    left_table  TYPE string,
    left_field  TYPE string,
    operator    TYPE string,
    right_table TYPE string,
    right_field TYPE string,
    source      TYPE string,
  END OF ty_view_join,
  tt_view_join TYPE STANDARD TABLE OF ty_view_join WITH EMPTY KEY,
  BEGIN OF ty_view_selection,
    field_name TYPE string,
    negation   TYPE string,
    operator   TYPE string,
    constants  TYPE string,
    and_or     TYPE string,
  END OF ty_view_selection,
  tt_view_selection TYPE STANDARD TABLE OF ty_view_selection WITH EMPTY KEY,
  BEGIN OF ty_view_data,
    format_version       TYPE string,
    type                 TYPE string,
    name                 TYPE string,
    package              TYPE string,
    header               TYPE ty_ddic_header,
    view_class           TYPE string,
    root_table           TYPE string,
    tables               TYPE tt_view_table,
    fields               TYPE tt_view_field,
    join_conditions      TYPE tt_view_join,
    selection_conditions TYPE tt_view_selection,
  END OF ty_view_data,
  BEGIN OF ty_view_write_request,
    format_version       TYPE string,
    name                 TYPE string,
    package              TYPE string,
    transport_request    TYPE string,
    header               TYPE ty_ddic_header,
    view_class           TYPE string,
    root_table           TYPE string,
    tables               TYPE tt_view_table,
    fields               TYPE tt_view_field,
    join_conditions      TYPE tt_view_join,
    selection_conditions TYPE tt_view_selection,
  END OF ty_view_write_request.

