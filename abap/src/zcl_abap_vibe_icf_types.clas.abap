" ----- DDIC shared helpers (extracted from reference implementation) -----
TYPES:
  BEGIN OF ty_field,
    fieldName   TYPE fieldname,
    precField   TYPE dd03p-precfield,
    rollname    TYPE rollname,
    dataType    TYPE dd03p-datatype,
    length      TYPE dd03p-leng,
