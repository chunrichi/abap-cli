#!/usr/bin/env bash
# Pre-push hook — runs `npm run verify` before any non-tag push.
# Wired via `git config core.hooksPath .githooks` (see scripts/setup-hooks.sh).
# Escape hatch: `git push --no-verify` (use only when you know verify passes).
#
# NOTE: this hook is the SOLE verify gate. The verify.yml workflow was removed
# to keep CI lean — there is no CI verify on push or PR. Every contributor must
# run `bash scripts/setup-hooks.sh` once after cloning, otherwise their push
# skips verification entirely.
set -euo pipefail

# `git push` feeds refs on stdin. Two formats observed:
#   - Branch/tag push:  "refs/heads/<name> <sha> refs/heads/<name> <sha>\n"
#                       "refs/tags/<name> <sha> refs/tags/<name> <sha>\n"
#   - Ref deletion:      "\0<ref>\0<ref>\0"  (NUL-separated, no sha)
#
# Strategy: slurp stdin, strip NULs (turn them into newlines so both formats
# look line-oriented), then check whether any line mentions refs/tags/.
# If so, skip — tag pushes don't need verify (commit was already verified),
# and ref deletions never need it.
stdin_text=$(cat | tr '\0' '\n')

if printf '%s' "$stdin_text" | grep -q '^refs/tags/'; then
  exit 0
fi

echo "▶ pre-push: npm run verify"
npm run verify
