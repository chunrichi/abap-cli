{
  "name": "abap-cli",
  "version": "1.0.0",
  "description": "CLI tool for ABAP vibe coding \u2014 agent-driven ABAP development in any agent",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "abap": "dist/index.js"
  },
  "files": [
    "dist",
    "abap/src",
    "skills",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chunrichi/abap-cli.git"
  },
  "homepage": "https://github.com/chunrichi/abap-cli#readme",
  "bugs": {
    "url": "https://github.com/chunrichi/abap-cli/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && tsc && node scripts/copy-bundled-schema.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run verify",
    "build-schema": "node scripts/build-cli-schema.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-skills-drift": "node scripts/check-skills-drift.mjs",
    "check-skills-drift:json": "node scripts/check-skills-drift.mjs --json",
    "check-skills-drift:fix": "node scripts/check-skills-drift.mjs --fix",
    "verify": "npm run build && npm test && npm run docs:check && npm run check-skills-drift",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "docs:build": "node scripts/gen-docs.mjs --write",
    "docs:check": "node scripts/gen-docs.mjs --check"
  },
  "keywords": [
    "abap",
    "sap",
    "cli",
    "agent",
    "vibe-coding"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "abap-adt-api": "^8.4.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.7.0",
    "commander": "^12.0.0",
    "fast-xml-parser": "^4.4.0",
    "ignore": "^5.3.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^1.6.0",
    "playwright": "^1.62.1",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
