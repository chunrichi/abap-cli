{
  "name": "abap-cli",
  "version": "0.2.6",
  "description": "CLI tool for ABAP vibe coding — agent-driven ABAP development in any agent",
  "type": "module",
  "main": "dist/src/abap_cli/index.js",
  "bin": {
    "abap": "dist/src/abap_cli/index.js"
  },
  "files": [
    "dist",
    "src/abap_cli/output/cli-output.schema.json",
    "abap/src",
    "skills",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chunrichi/abap-cli.git"
  },
  "homepage": "https://github.com/chunrichi/abap-cli#readme",
  "bugs": {
    "url": "https://github.com/chunrichi/abap-cli/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-bundled-schema.mjs",
    "dev": "tsc --watch",
    "start": "node dist/src/abap_cli/index.js",
    "prepublishOnly": "npm run build",
    "build-schema": "tsx scripts/build-cli-schema.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build-docs": "node scripts/build-commands-doc.mjs",
    "verify": "npm run build && npm test"
  },
  "keywords": [
    "abap",
    "sap",
    "cli",
    "agent",
    "vibe-coding"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "abap-adt-api": "^8.4.1",
    "axios": "^1.7.0",
    "commander": "^12.0.0",
    "fast-xml-parser": "^4.4.0",
    "ignore": "^5.3.0",
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^1.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
