# SAP connection (passwords are NOT read from env — use `abap profile set <name> --password`)
SAP_URL=https://your-sap-server.com:44300
SAP_USER=YOUR_USERNAME
SAP_CLIENT=100
SAP_LANGUAGE=EN

# TLS — for self-signed certs (development only) use:
#   abap config --insecure              # skip cert verification
#   abap config --ca /path/to/ca.pem    # trust a custom CA
# The NODE_TLS_REJECT_UNAUTHORIZED=0 env var is still honored as a fallback.
NODE_TLS_REJECT_UNAUTHORIZED=1
